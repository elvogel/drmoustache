<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DrMoustache.Minimal</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Must match Directory.Build.props's <Version>; a test in the DrMoustache
         solution asserts this, so drift here fails CI rather than a stranger's restore. -->
    <PackageReference Include="DrMoustache" Version="0.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="templates/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
